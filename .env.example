# ==============================================================================
# GARMIN HEALTH AI PIPELINE - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to '.env' and fill in your actual API credentials.
# ==============================================================================

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_CHAT_ID="your_telegram_chat_id_here"

# Google Gemini AI API Configuration
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.6-flash"
GEMINI_VISION_MODEL="gemini-3.6-flash"

# Garmin Connect Credentials (Optional: used for direct cloud sync)
GARMIN_EMAIL="your_garmin_email_here"
GARMIN_PASSWORD="your_garmin_password_here"

# Database & System Path Configuration
DB_PATH="data/garmin_health.db"
REPORT_SCHEDULE_TIME="04:45"
