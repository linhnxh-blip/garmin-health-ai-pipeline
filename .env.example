# ==============================================================================
# GARMIN HEALTH AI PIPELINE - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to '.env' and fill in your actual API credentials.
# ==============================================================================

# 1. Telegram Bot Integration
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_CHAT_ID="your_telegram_chat_id_here"

# 2. Google Gemini AI API Configuration
LLM_PROVIDER="gemini"
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.6-flash"
GEMINI_VISION_MODEL="gemini-3.6-flash"

# 3. OpenAI Configuration (Optional fallback)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# 4. Garmin Connect Credentials (Used for direct cloud sync)
GARMIN_USERNAME="your_garmin_email_here"
GARMIN_EMAIL="your_garmin_email_here"
GARMIN_PASSWORD="your_garmin_password_here"
GARMIN_TOKEN_DIR="data/.garmin_tokens"

# 5. Database & System Path Configuration
DB_PATH="data/garmin_health.db"
REPORT_SCHEDULE_TIME="04:45"
NIGHTLY_RUN_TIME="23:00"

# 6. Local Server / Tailscale / LAN Web Dashboard Configuration (ASUS ROG Ally X)
# Set WEB_HOST="0.0.0.0" to allow access from MacBook, PC, and Mobile via Tailscale/LAN
WEB_HOST="0.0.0.0"
WEB_PORT=8000
BASE_WEB_URL="http://100.x.y.z:8000"
