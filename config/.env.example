# ==========================================
# GARMIN HEALTH AI PIPELINE CONFIGURATION
# ==========================================

# Database Path
DB_PATH=data/garmin_health.db

# Garmin Connect Credentials
GARMIN_USERNAME=your_garmin_email@example.com
GARMIN_PASSWORD=your_garmin_password
GARMIN_TOKEN_DIR=.garminconnect

# LLM Provider Configuration ("gemini" or "openai")
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Google Keep Credentials / Token
# Note: gkeepapi requires email & app password or master token
GOOGLE_KEEP_EMAIL=your_google_email@gmail.com
GOOGLE_KEEP_APP_PASSWORD=your_google_app_password
GOOGLE_KEEP_MASTER_TOKEN=

# Scheduler Configuration
NIGHTLY_RUN_TIME=23:00
